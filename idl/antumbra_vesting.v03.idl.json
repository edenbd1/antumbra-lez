{
  "version": "0.3.0",
  "name": "antumbra_vesting",
  "lez": "v0.3.0 (db66590ab821a4e142c211017a3866d007f6fa77)",
  "notes": [
    "Hand-maintained in SPEL's IDL shape: SPEL has no LEZ v0.3 support. scripts/check-idl.py decodes borsh vectors emitted by the core crate with this file and fails on any drift.",
    "The instruction is a borsh enum: one u8 discriminant, then the args in order.",
    "Every account row selects one shard. shard=self is this program's shard; shard=asset is the native shard (all-zero id) for Asset::Native, the token program's shard for Asset::Token. A signer handle is a signing row with shard=self that the program never writes.",
    "PDAs derive from the program's header account: AccountId::for_public_pda(header, seed). One seed is used as is; several are combined as SHA-256 of their concatenation. Const seeds are zero-padded to 32 bytes.",
    "Refusals are guest panics whose message starts with E<code>:"
  ],
  "instructions": [
    {
      "name": "create_schedule",
      "discriminant": 0,
      "accounts": [
        { "name": "schedule", "writable": true, "signer": false, "init": true, "shard": "self",
          "pda": { "seeds": [ { "kind": "arg", "path": "schedule_id" } ] } },
        { "name": "holding", "writable": true, "signer": false, "init": false, "shard": "asset",
          "pda": { "seeds": [ { "kind": "arg", "path": "schedule_id" }, { "kind": "const", "value": "holding" } ] } },
        { "name": "creator", "writable": true, "signer": true, "init": false, "shard": "asset" }
      ],
      "args": [
        { "name": "schedule_id", "type": { "array": ["u8", 32] } },
        { "name": "beneficiary", "type": "account_id" },
        { "name": "asset", "type": { "defined": "Asset" } },
        { "name": "terms", "type": { "defined": "Terms" } }
      ],
      "effects": "writes the schedule; chains a transfer of exactly terms.total from creator to holding"
    },
    {
      "name": "create_schedule_batch",
      "discriminant": 1,
      "accounts": [
        { "name": "holding", "writable": true, "signer": false, "init": false, "shard": "asset",
          "pda": { "seeds": [ { "kind": "arg", "path": "batch_id" }, { "kind": "const", "value": "holding" } ] } },
        { "name": "creator", "writable": true, "signer": true, "init": false, "shard": "asset" },
        { "name": "schedules", "writable": true, "signer": false, "init": true, "shard": "self", "rest": true,
          "pda": { "seeds": [ { "kind": "arg", "path": "batch_id" }, { "kind": "index_u32_le", "path": "i" } ] } }
      ],
      "args": [
        { "name": "batch_id", "type": { "array": ["u8", 32] } },
        { "name": "beneficiaries", "type": { "vec": "account_id" } },
        { "name": "asset", "type": { "defined": "Asset" } },
        { "name": "terms", "type": { "defined": "Terms" } }
      ],
      "effects": "writes one schedule per beneficiary; chains one transfer of terms.total x n into the shared holding"
    },
    {
      "name": "claim",
      "discriminant": 2,
      "accounts": [
        { "name": "schedule", "writable": true, "signer": false, "init": false, "shard": "self",
          "pda": { "seeds": [ { "kind": "arg", "path": "schedule_id" } ] } },
        { "name": "holding", "writable": true, "signer": false, "init": false, "shard": "asset",
          "pda": { "seeds": [ { "kind": "arg", "path": "batch_id ?? schedule_id" }, { "kind": "const", "value": "holding" } ] } },
        { "name": "destination", "writable": true, "signer": false, "init": false, "shard": "asset", "private_ok": true },
        { "name": "beneficiary", "writable": false, "signer": true, "init": false, "shard": "self" }
      ],
      "args": [
        { "name": "schedule_id", "type": { "array": ["u8", 32] } },
        { "name": "batch_id", "type": { "option": { "array": ["u8", 32] } } },
        { "name": "asset", "type": { "defined": "Asset" } },
        { "name": "amount", "type": "u128" },
        { "name": "at", "type": "u64" }
      ],
      "timestamp_window": "[at, inf)",
      "effects": "apply refuses unless amount <= vested(at) - claimed; chains a seeded transfer of amount from holding to destination"
    },
    {
      "name": "cancel",
      "discriminant": 3,
      "accounts": [
        { "name": "schedule", "writable": true, "signer": false, "init": false, "shard": "self",
          "pda": { "seeds": [ { "kind": "arg", "path": "schedule_id" } ] } },
        { "name": "holding", "writable": true, "signer": false, "init": false, "shard": "asset",
          "pda": { "seeds": [ { "kind": "arg", "path": "batch_id ?? schedule_id" }, { "kind": "const", "value": "holding" } ] } },
        { "name": "refund", "writable": true, "signer": false, "init": false, "shard": "asset" },
        { "name": "authority", "writable": false, "signer": true, "init": false, "shard": "self" }
      ],
      "args": [
        { "name": "schedule_id", "type": { "array": ["u8", 32] } },
        { "name": "batch_id", "type": { "option": { "array": ["u8", 32] } } },
        { "name": "asset", "type": { "defined": "Asset" } },
        { "name": "at", "type": "u64" },
        { "name": "refund", "type": "u128" }
      ],
      "timestamp_window": "[at, at + 120000)",
      "effects": "apply refuses unless refund == total - vested(at) and at >= last_seen; chains a seeded transfer of refund to the refund account fixed at creation"
    },
    {
      "name": "make_non_cancelable",
      "discriminant": 4,
      "accounts": [
        { "name": "schedule", "writable": true, "signer": false, "init": false, "shard": "self",
          "pda": { "seeds": [ { "kind": "arg", "path": "schedule_id" } ] } },
        { "name": "creator", "writable": false, "signer": true, "init": false, "shard": "self" }
      ],
      "args": [
        { "name": "schedule_id", "type": { "array": ["u8", 32] } }
      ]
    },
    {
      "name": "transfer_beneficiary",
      "discriminant": 5,
      "accounts": [
        { "name": "schedule", "writable": true, "signer": false, "init": false, "shard": "self",
          "pda": { "seeds": [ { "kind": "arg", "path": "schedule_id" } ] } },
        { "name": "beneficiary", "writable": false, "signer": true, "init": false, "shard": "self" }
      ],
      "args": [
        { "name": "schedule_id", "type": { "array": ["u8", 32] } },
        { "name": "new_beneficiary", "type": "account_id" }
      ]
    },
    {
      "name": "signal_milestone",
      "discriminant": 6,
      "accounts": [
        { "name": "schedule", "writable": true, "signer": false, "init": false, "shard": "self",
          "pda": { "seeds": [ { "kind": "arg", "path": "schedule_id" } ] } },
        { "name": "authority", "writable": false, "signer": true, "init": false, "shard": "self" }
      ],
      "args": [
        { "name": "schedule_id", "type": { "array": ["u8", 32] } },
        { "name": "index", "type": "u32" }
      ]
    }
  ],
